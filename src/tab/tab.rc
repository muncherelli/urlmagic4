#include <windows.h>
#include "resource.h"
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    UM_VERSION_NUM
 PRODUCTVERSION UM_VERSION_NUM
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "urlmagic4 contributors\0"
            VALUE "FileDescription",  "URL Magic tab for Internet Service Manager\0"
            VALUE "FileVersion",      UM_VERSION_STR "\0"
            VALUE "InternalName",     "urlmagic4-mmc-snap-in\0"
            VALUE "LegalCopyright",   "MIT License\0"
            VALUE "OriginalFilename", "urlmagic4-mmc-snap-in.dll\0"
            VALUE "ProductName",      "urlmagic4\0"
            VALUE "ProductVersion",   UM_VERSION_STR "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDI_TAB ICON "../../res/urlmagic4.ico"

/* 252 x 218 dialog units: the size of IIS 4's own property pages */
IDD_SITE DIALOG 0, 0, 252, 218
STYLE WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "URL Magic"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "", IDC_SITE, 7, 7, 238, 10
    AUTOCHECKBOX    "&Enable URL rewriting for this site", IDC_ENABLED, 7, 22, 238, 10

    GROUPBOX        "Rules format", IDC_FMT_GROUP, 7, 38, 238, 52
    AUTORADIOBUTTON "A&utomatic (by file name)", IDC_FMT_AUTO, 14, 50, 224, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Apache mod_rewrite (httpd.htaccess or .htaccess)", IDC_FMT_HTACCESS, 14, 62, 224, 10
    AUTORADIOBUTTON "&ISAPI_Rewrite 2 (httpd.ini)", IDC_FMT_HTTPDINI, 14, 74, 224, 10

    GROUPBOX        "Rules file", IDC_SRC_GROUP, 7, 96, 238, 66
    AUTORADIOBUTTON "In the site's &home directory", IDC_SRC_DOCROOT, 14, 108, 224, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "In this &file:", IDC_SRC_FILE, 14, 122, 224, 10
    EDITTEXT        IDC_FILE, 24, 137, 158, 13, ES_AUTOHSCROLL | WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 188, 136, 50, 14

    AUTOCHECKBOX    "&Debug: log every request and how long the rules took", IDC_DEBUG, 7, 168, 238, 10

    LTEXT           "Use ""In this file"" for a site whose home directory is a network share: IIS can't read rules from there. Changes take effect on the next request; no IIS restart needed. The log is urlmagic4.log in the urlmagic folder.", -1, 7, 184, 238, 30
END
