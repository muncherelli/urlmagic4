#include <windows.h>
#include "resource.h"
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    UM_VERSION_NUM
 PRODUCTVERSION UM_VERSION_NUM
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "urlmagic4 contributors\0"
            VALUE "FileDescription",  "URL Magic tab for Internet Service Manager\0"
            VALUE "FileVersion",      UM_VERSION_STR "\0"
            VALUE "InternalName",     "urlmagic4-mmc-snap-in\0"
            VALUE "LegalCopyright",   "MIT License\0"
            VALUE "OriginalFilename", "urlmagic4-mmc-snap-in.dll\0"
            VALUE "ProductName",      "urlmagic4\0"
            VALUE "ProductVersion",   UM_VERSION_STR "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDI_TAB ICON "../../res/urlmagic4.ico"

/* 252 x 218 dialog units: the size of IIS 4's own property pages */
IDD_SITE DIALOG 0, 0, 252, 218
STYLE WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "URL Magic"
FONT 8, "MS Sans Serif"
BEGIN
    AUTOCHECKBOX    "&Enable URL rewriting for this site", IDC_ENABLED, 7, 7, 238, 10

    GROUPBOX        "Rules format", IDC_FMT_GROUP, 7, 23, 238, 64
    AUTORADIOBUTTON "A&utomatic (by file name)", IDC_FMT_AUTO, 14, 35, 224, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Apache mod_rewrite (httpd.htaccess or .htaccess)", IDC_FMT_HTACCESS, 14, 47, 224, 10
    AUTORADIOBUTTON "&ISAPI_Rewrite 2 (httpd.ini)", IDC_FMT_HTTPDINI, 14, 59, 224, 10
    /* not finished yet: shown, but can't be chosen */
    AUTORADIOBUTTON "nginx rewrite (nginx.conf), coming soon", IDC_FMT_NGINX, 14, 71, 224, 10, WS_DISABLED

    GROUPBOX        "Rules file", IDC_SRC_GROUP, 7, 93, 238, 66
    AUTORADIOBUTTON "In the site's &home directory", IDC_SRC_DOCROOT, 14, 105, 224, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "In this &file:", IDC_SRC_FILE, 14, 119, 224, 10
    EDITTEXT        IDC_FILE, 24, 134, 158, 13, ES_AUTOHSCROLL | WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 188, 133, 50, 14

    AUTOCHECKBOX    "&Debug: log every request and how long the rules took", IDC_DEBUG, 7, 165, 238, 10

    LTEXT           "Changes take effect on the next request; no IIS restart needed. The log is urlmagic4.log in the urlmagic folder.", -1, 7, 179, 238, 18

    /* only shown if the settings couldn't be read */
    LTEXT           "", IDC_SITE, 7, 197, 238, 9, NOT WS_VISIBLE

    /* out of the way along the bottom: where it comes from, and which version */
    LTEXT           "github.com/muncherelli/urlmagic4", -1, 7, 207, 160, 9
    RTEXT           "", IDC_VERSION, 170, 207, 75, 9
END
